# Otueke Booking - example environment. PLACEHOLDERS ONLY: never commit real values.
# Copy to .env and run `php artisan key:generate`.

APP_NAME="Otueke Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# The app runs in UTC (as does the API). Convert to local time for display only.
OTUEKE_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Otueke API (the single owner of business data) ---
OTUEKE_API_BASE_URL=http://127.0.0.1:5080
OTUEKE_API_PREFIX=/api/v1
OTUEKE_API_TIMEOUT=10
OTUEKE_API_CONNECT_TIMEOUT=3
# Public client identifier registered in the API (not a secret)
OTUEKE_API_CLIENT_ID=otueke-booking-web

# --- Database ---
# No application database: all business data is owned by the Otueke API.
# An optional READ-ONLY reporting connection (OTUEKE_REPORTING_DB_*) may be
# introduced by ADR. Do not add write access to the business schema here.
# DB_CONNECTION=
# OTUEKE_REPORTING_DB_HOST=
# OTUEKE_REPORTING_DB_PORT=3306
# OTUEKE_REPORTING_DB_DATABASE=
# OTUEKE_REPORTING_DB_USERNAME=
# OTUEKE_REPORTING_DB_PASSWORD=

# Sessions hold the API access token server-side (never sent to the browser).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
