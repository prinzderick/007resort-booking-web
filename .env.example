# 007 Resort & Spa Booking - example environment. PLACEHOLDERS ONLY: never commit real values.
# Copy to .env and run `php artisan key:generate`.

APP_NAME="007 Resort & Spa Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# The app runs in UTC (as does the API). Convert to local time for display only.
R007_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- 007 Resort & Spa API (the single owner of business data) ---
R007_API_BASE_URL=http://127.0.0.1:5080
R007_API_PREFIX=/api/v1
R007_API_TIMEOUT=10
R007_API_CONNECT_TIMEOUT=3
# Public client identifier registered in the API (not a secret)
R007_API_CLIENT_ID=007resort-booking-web
# Service token of the "online" channel, used for public reads when nobody is
# signed in. SECRET: set only in the real environment / secret store.
R007_API_SERVICE_TOKEN=

# Mock API mode: run the whole site without the backend (dev/demo only).
R007_MOCK=false
# Mock only: comma list of facility keys shown as "online booking paused", e.g. salon,pool
R007_MOCK_OFFLINE_FACILITIES=

# Booking UX
R007_BOOKING_HORIZON_DAYS=30

# Public contact details (the API's /public/site overrides these when available)
SITE_PHONE="+234 000 000 0000"
SITE_EMAIL=hello@example.com
SITE_ADDRESS="007 Resort & Spa, Otueke, Bayelsa State, Nigeria"
SITE_MAP_URL=

# Reverse proxy (nginx/caddy on the Cloud VPS): addresses whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=127.0.0.1

# --- Database ---
# No application database: all business data is owned by the 007 Resort & Spa API.
# An optional READ-ONLY reporting connection (R007_REPORTING_DB_*) may be
# introduced by ADR. Do not add write access to the business schema here.
# DB_CONNECTION=
# R007_REPORTING_DB_HOST=
# R007_REPORTING_DB_PORT=3306
# R007_REPORTING_DB_DATABASE=
# R007_REPORTING_DB_USERNAME=
# R007_REPORTING_DB_PASSWORD=

# Sessions hold the API access token server-side (never sent to the browser).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Public site v2: CMS content (007resort-api CMS module) ---
# true = bundled sample content (offline dev); false = call {R007_API_BASE_URL}/api/v1/public/cms with the service token
CMS_FIXTURES=false
CMS_CACHE_TTL=60
CMS_STALE_TTL=86400
CMS_TIMEOUT=4
CMS_PAGE_MAX_AGE=60
# Extra image origins allowed by the CSP (e.g. a CDN in front of CMS media), comma separated
CMS_MEDIA_HOSTS=
CMS_SUBSCRIBE_POPUP=true
SITE_VIEW_TRANSITIONS=true

# Guest checkout
R007_CONSENT_VERSION=2026-09
GUEST_EMAIL_DELIVERY=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Social sign-in (Google, Facebook). Runbook: docs/SOCIAL_LOGIN_SETUP.md ---
# Providers this site may offer. A button also needs credentials below AND the provider enabled in the API.
SOCIAL_ENABLED_PROVIDERS=google,facebook
# Redirect URIs to register at the providers: ${APP_URL}/auth/google/callback and ${APP_URL}/auth/facebook/callback
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
# Extra https avatar hosts allowed in img-src (comma separated). Google/Facebook hosts are built in.
SOCIAL_AVATAR_HOSTS=
# Local fake Google/Facebook screen for demos and tests. IGNORED when APP_ENV=production.
SOCIAL_FAKE=false
